# Handle line endings automatically for files detected as text
# and leave binary files untouched.
* text=auto

# Standardize on LF line endings for all text files
*.go text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
