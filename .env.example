# Authentication
APP_USER=admin
# DO NOT USE IN PRODUCTION — replace with a strong secret
APP_PASS=CHANGE_ME_TO_SECURE_PASSWORD
# SESSION_SECRET: generate a secure value using 'openssl rand -base64 32'
SESSION_SECRET=<generate_a_secure_value>

# Database
DB_TYPE=postgres
# DB_HOST: 'db' is the bundled PostgreSQL service under Docker Compose. Use
# 'localhost' when running the binary directly, or a hostname to point at an
# external server (the bundled db service then goes unused).
DB_HOST=db
DB_PORT=5432
DB_USER=tauuser
# DB_PASSWORD: required — there is no default. Both the application and the
# PostgreSQL container refuse to start if it is unset.
DB_PASSWORD=CHANGE_ME
DB_NAME=taunewlety
# DB_SSLMODE: the application defaults to the secure 'require'. The bundled
# Compose PostgreSQL runs on an isolated internal network without TLS, so
# docker-compose.yml falls back to 'disable' when this is unset. Set it
# explicitly — require, verify-ca or verify-full — whenever DB_HOST points at
# an external database.
#DB_SSLMODE=require

# Email Notifications
NOTIFY_EMAIL=admin@example.com
# SMTP_ENCRYPTION: starttls (default, port 587), tls (implicit TLS, port 465), none (plain text, NOT recommended)
SMTP_ENCRYPTION=starttls

# Server
PORT=8080
# TLS_CERT and TLS_KEY: Optional paths to TLS certificate and key files.
# If both are set, the server starts with HTTPS directly.
# For production, a reverse proxy (nginx/caddy) is recommended instead.
#
# Under Docker Compose these must be paths *inside* the container. Uncomment
# the matching read-only volume mounts in deployments/docker/docker-compose.yml
# and place the files at deployments/docker/certs/ on the host.
# TLS_CERT=/certs/cert.pem
# TLS_KEY=/certs/key.pem

# AI Model
OLLAMA_MODEL=llama3.2:3b
