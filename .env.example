# Authentication
APP_USER=admin
# DO NOT USE IN PRODUCTION — replace with a strong secret
APP_PASS=CHANGE_ME_TO_SECURE_PASSWORD
# SESSION_SECRET: generate a secure value using 'openssl rand -base64 32'
SESSION_SECRET=<generate_a_secure_value>

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=tauuser
# DB_PASSWORD: MUST be replaced with a secure password for production
DB_PASSWORD=CHANGE_ME
DB_NAME=taunewlety
# DB_SSLMODE: defaults to 'require'. Set to 'disable' for local development only.
DB_SSLMODE=disable

# Email Notifications
NOTIFY_EMAIL=admin@example.com

# Server
PORT=8080

# AI Model
OLLAMA_MODEL=llama3.2:3b
