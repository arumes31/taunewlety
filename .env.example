# Authentication
APP_USER=admin
# DO NOT USE IN PRODUCTION — replace with a strong secret
APP_PASS=CHANGE_ME_TO_SECURE_PASSWORD
# SESSION_SECRET: generate a secure value using 'openssl rand -base64 32'
SESSION_SECRET=<generate_a_secure_value>
# SESSION_MAX_AGE: admin session lifetime (Go duration). Default 12h.
#SESSION_MAX_AGE=12h
# COOKIE_SECURE: the session cookie is Secure by default. Set to false only
# for local development over plain HTTP.
#COOKIE_SECURE=true
# UNSUBSCRIBE_SECRET: optional key for signing unsubscribe links. Defaults to
# SESSION_SECRET; set it to rotate SESSION_SECRET without breaking links in
# newsletters already sent.
#UNSUBSCRIBE_SECRET=
# CONFIG_ENCRYPTION_KEY: optional. Encrypts the stored Tautulli API key, Plex
# token, SMTP password and Telegram bot token. Generate with
# 'openssl rand -base64 32' and keep it safe.
#CONFIG_ENCRYPTION_KEY=

# Database
DB_TYPE=postgres
# DB_HOST: 'db' is the bundled PostgreSQL service under Docker Compose. Use
# 'localhost' when running the binary directly, or a hostname to point at an
# external server (the bundled db service then goes unused).
DB_HOST=db
DB_PORT=5432
DB_USER=tauuser
# DB_PASSWORD: required — there is no default. Both the application and the
# PostgreSQL container refuse to start if it is unset.
DB_PASSWORD=CHANGE_ME
DB_NAME=taunewlety
# DB_SSLMODE: the application defaults to 'verify-full' (TLS with certificate
# and hostname verification). The bundled Compose PostgreSQL runs on an
# isolated internal network without TLS, so docker-compose.yml falls back to
# 'disable' when this is unset. For an external database keep verify-full and,
# if its certificate is not publicly trusted, point DB_SSLROOTCERT at the CA
# bundle. 'require' encrypts without authenticating the server and should only
# be used as a deliberate override.
#DB_SSLMODE=verify-full
#DB_SSLROOTCERT=/path/to/root.crt

# Email Notifications
NOTIFY_EMAIL=admin@example.com
# SMTP_ENCRYPTION: starttls (default, port 587), tls (implicit TLS, port 465), none (plain text, NOT recommended)
SMTP_ENCRYPTION=starttls

# Server
PORT=8080
# TRUSTED_PROXIES: comma-separated IPs/CIDRs of the reverse proxy in front of
# the app, so client IPs are taken from X-Forwarded-For. Empty trusts none.
#TRUSTED_PROXIES=172.16.0.0/12
# TLS_CERT and TLS_KEY: Optional paths to TLS certificate and key files.
# If both are set, the server starts with HTTPS directly.
# For production, a reverse proxy (nginx/caddy) is recommended instead.
#
# Under Docker Compose these must be paths *inside* the container. Uncomment
# the matching read-only volume mounts in deployments/docker/docker-compose.yml
# and place the files at deployments/docker/certs/ on the host.
# TLS_CERT=/certs/cert.pem
# TLS_KEY=/certs/key.pem

# AI Model
OLLAMA_MODEL=llama3.2:3b
