# Set credentials for authentication (instructions: set strong, unique values in production!)
# e.g., APP_USER=<your-username> and APP_PASS=<strong-password-or-secret-from-vault>
APP_USER=<your-username>
APP_PASS=<strong-password>

# Session Secret (Mandatory in production. Change this!)
# Generate a secure secret using: openssl rand -hex 32
SESSION_SECRET=<your-strong-session-secret>

NOTIFY_EMAIL=users@example.com
PORT=8080
DB_PATH=taunewlety.db
OLLAMA_MODEL=llama3.2:3b
